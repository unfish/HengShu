定义 病例 为 表格处理 把记录整理成表格([
    {"住院号": "H0001", "姓名": "张三", "分组": "试验组", "年龄": 54, "指标": 7.8},
    {"住院号": "H0002", "姓名": "李四", "分组": "试验组", "年龄": 61, "指标": 7.1},
    {"住院号": "H0003", "姓名": "王五", "分组": "试验组", "年龄": 47, "指标": 8.2},
    {"住院号": "H0004", "姓名": "赵六", "分组": "试验组", "年龄": 58, "指标": 7.5},
    {"住院号": "H0005", "姓名": "钱七", "分组": "对照组", "年龄": 52, "指标": 9.4},
    {"住院号": "H0006", "姓名": "孙八", "分组": "对照组", "年龄": 65, "指标": 9.9},
